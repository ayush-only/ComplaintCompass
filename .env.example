# Pick ONE of the three setups below. Copy this file to .env and fill it in.

# --- Setup A: Anthropic only ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_MODEL_STRONG=claude-sonnet-5-5

# --- Setup B: one free OpenAI-compatible provider ---
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# --- Setup C: a fallback chain, tried in order (up to LLM_9_*) ---
# When one is out of quota, rejects its key, or stays rate-limited, the next takes over.
# If you use this, delete or comment out Setups A and B.
# LLM_1_PROVIDER=openai_compat
# LLM_1_BASE_URL=https://api.groq.com/openai/v1
# LLM_1_API_KEY=
# LLM_1_MODEL=llama-3.3-70b-versatile
#
# LLM_2_PROVIDER=openai_compat
# LLM_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_2_API_KEY=
# LLM_2_MODEL=gemini-2.5-flash
#
# LLM_3_PROVIDER=anthropic
# LLM_3_API_KEY=
# LLM_3_MODEL=claude-haiku-5-5
# LLM_3_MODEL_STRONG=claude-sonnet-5-5

# Free tiers allow roughly 30 requests/minute: keep severity at 2 workers
# SEVERITY_WORKERS=2

LLM_CACHE_DIR=.llm_cache
